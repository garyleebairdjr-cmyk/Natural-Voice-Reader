# Optional cloud fallback. Leave unset to use local VoiceStudio, then the browser voice.
# XAI_API_KEY=

# Local VoiceStudio OpenAI-compatible API (loopback, no key required by default).
VOICESTUDIO_URL=http://127.0.0.1:3900

# omnivoice (higher quality, default) or kittentts (lighter on the CPU)
# VOICESTUDIO_TTS_MODEL=omnivoice
